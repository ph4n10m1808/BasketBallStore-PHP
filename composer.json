{
    "name": "ph4n10m/basketball-store",
    "description": "Basketball Store - PHP Educational Cybersecurity Lab",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "src/Models/",
            "src/Controllers/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite Unit",
        "test:integration": "phpunit --configuration phpunit.xml --testsuite Integration"
    }
}
