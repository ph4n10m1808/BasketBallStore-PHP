<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../../tests/phpunit/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>../../tests/phpunit/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>../../tests/phpunit/Integration</directory>
        </testsuite>
    </testsuites>

    <php>
        <env name="MYSQL_HOSTNAME" value="127.0.0.1"/>
        <env name="MYSQL_DATABASE" value="basketball_store"/>
        <env name="MYSQL_USER" value="test_user"/>
        <env name="MYSQL_PASSWORD" value="test_password"/>
        <env name="MYSQL_ROOT_PASSWORD" value="root_test_password"/>
    </php>

    <source>
        <include>
            <directory>app</directory>
            <directory>admin</directory>
        </include>
        <exclude>
            <directory>app/Views</directory>
            <directory>public</directory>
            <directory>admin/Views</directory>
        </exclude>
    </source>
</phpunit>
